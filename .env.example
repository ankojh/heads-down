# Copy to .env and fill in. .env is gitignored.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_DEFAULT_MODEL=jev-1.13.0

# Optional: Google Calendar auto-start. OAuth client of type "Desktop app" from your own Google
# Cloud project (see README). The client ID is not a secret; desktop "client secrets" aren't either,
# but leave it out of commits anyway. Your Google tokens are stored in the macOS Keychain, not here.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=
